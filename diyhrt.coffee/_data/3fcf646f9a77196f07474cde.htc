8:["$","section",null,{"className":"ereb-box","children":[["$","div",null,{"className":"ereb-section-title","children":"// if you set up alerts"}],["$","div",null,{"className":"space-y-3 px-6 py-5 font-mix text-[11px] normal-case tracking-normal text-text leading-relaxed prose [&_strong]:text-fg","children":[["$","p",null,{"children":"each alert destination you create stores: the kind (webhook / DM / server channel), the config you provided (a discord webhook URL, or a guild + channel id, or your discord user id for DMs), and any filters you set (item / shop / region / keyword choices, an optional role id to ping)."}],["$","p",null,{"children":"stock-change events that match your filters get sent to those destinations. we don't log the message contents."}]]}]]}]
